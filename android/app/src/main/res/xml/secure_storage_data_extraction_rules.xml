<?xml version="1.0" encoding="utf-8"?>
<!-- F31: Android 12+ 的备份 / 设备迁移规则，与 secure_storage_backup_rules.xml
     同理：Keystore 加密的会话文件不随备份或换机迁移走。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>