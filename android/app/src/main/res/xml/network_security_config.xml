<?xml version="1.0" encoding="utf-8"?>
<!-- 后端只有裸 IP（198.23.213.22，无证书/域名），题库清单走明文 HTTP，
     因此仅对该主机放开 cleartext；其余域名仍按 Android 默认策略禁止明文。 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">198.23.213.22</domain>
    </domain-config>
</network-security-config>
